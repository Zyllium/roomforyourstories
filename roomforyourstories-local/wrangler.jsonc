{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roomforyourstories",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "roomforyourstories.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roomforyourstories-db",
      "database_id": "343e497e-c48b-4ae8-a3bb-8a16670ad815",
      "migrations_dir": "drizzle"
    }
  ]
}
